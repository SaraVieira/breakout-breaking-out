:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;00B5&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+230&amp;#10;U+00B5 MICRO SIGN&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;µ&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;fn&quot;:{&quot;wt&quot;:&quot;{{Efn|230 (E6&lt;sub&gt;hex&lt;/sub&gt;) is identified by IBM as Greek \&quot;[[mu (letter)|Mu]] Small\&quot; [U+03BC, μ] but is also used as the [[micro sign]] [U+00B5, µ].  IBM's Greek GCGID table&lt;ref name=\&quot;GCGID_Greek\&quot;/&gt; maps the character in this code page to the Greek letter, but the cp437_DOSLatinUS to Unicode table&lt;ref name=\&quot;Unicode_1996_437\&quot;/&gt; maps it to the micro sign.}}&quot;}},&quot;i&quot;:246}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;03C4&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+231&amp;#10;U+03C4 GREEK SMALL LETTER TAU&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;τ&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;&quot;}},&quot;i&quot;:247}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;03A6&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+232&amp;#10;U+03A6 GREEK CAPITAL LETTER PHI&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Φ&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;&quot;}},&quot;i&quot;:248}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;0398&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+233&amp;#10;U+0398 GREEK CAPITAL LETTER THETA&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Θ&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;fn&quot;:{&quot;wt&quot;:&quot;{{Efn|233 (E9&lt;sub&gt;hex&lt;/sub&gt;) is identified by IBM as Greek \&quot;[[Theta]] Capital\&quot; [U+0398, Θ].&lt;ref name=\&quot;cpgid437pdf\&quot;/&gt;&lt;ref name=\&quot;CPGID_00437\&quot;/&gt; However, these symbols are for mathematics and physics, in which lowercase theta is much more commonly used (e.g. for polar coordinates).}}&quot;}},&quot;i&quot;:249}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;03A9&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+234&amp;#10;U+03A9 GREEK CAPITAL LETTER OMEGA&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;Ω&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;fn&quot;:{&quot;wt&quot;:&quot;{{Efn|234 (EA&lt;sub&gt;hex&lt;/sub&gt;) is identified by IBM as Greek \&quot;[[Omega]] Capital\&quot; [U+03A9, Ω] but is also used as the [[Ohm (unit)|ohm]] sign [U+2126, Ω]. Unicode considers the characters to be equivalent and suggests that U+03A9 be used in both contexts.&lt;ref name=\&quot;Unicode_2003_40\&quot;/&gt;}}&quot;}},&quot;i&quot;:250}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;03B4&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+235&amp;#10;U+03B4 GREEK SMALL LETTER DELTA&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;δ&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;fn&quot;:{&quot;wt&quot;:&quot;{{Efn|235 (EB&lt;sub&gt;hex&lt;/sub&gt;) is identified by IBM as Greek \&quot;[[Delta (letter)|Delta]] Small\&quot; [U+03B4, δ]. It was also unofficially used for the small [[eth]] [U+00F0, ð] and the [[partial derivative]] sign [U+2202, ∂]}}&quot;}},&quot;i&quot;:251}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;221E&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+236&amp;#10;U+221E INFINITY&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;∞&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;style&quot;:{&quot;wt&quot;:&quot;background:#EFF&quot;}},&quot;i&quot;:252}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;03C6&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+237&amp;#10;U+03C6 GREEK SMALL LETTER PHI&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;φ&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;fn&quot;:{&quot;wt&quot;:&quot;{{Efn|237 (ED&lt;sub&gt;hex&lt;/sub&gt;) is identified by IBM as Greek \&quot;[[Phi (letter)|Phi]] Small (Closed Form)\&quot; [U+03D5, ϕ; or, from the italicized math set, U+1D719, 𝜙] but, Unicode maps it to the open (or \&quot;loopy\&quot;) form [U+03C6, φ] in its cp437_DOSLatinUS table.&lt;ref name=\&quot;Unicode_1996_437\&quot;/&gt; Comparison of IBM's Greek GCGID table&lt;ref name=\&quot;GCGID_Greek\&quot;/&gt; with Unicode's Greek code chart&lt;ref name=\&quot;Unicode_Greek\&quot;/&gt; shows where IBM, for example, reversed the open and closed forms when mapping to Unicode. This character is also used as the [[empty set]] sign [U+2205, ∅], the [[diameter]] sign [U+2300, ⌀], and the [[Ø|Latin letter O with stroke]] [U+00D8, Ø; and U+00F8, ø].}}&quot;}},&quot;i&quot;:253}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;03B5&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+238&amp;#10;U+03B5 GREEK SMALL LETTER EPSILON&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ε&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;fn&quot;:{&quot;wt&quot;:&quot;{{Efn|238 (EE&lt;sub&gt;hex&lt;/sub&gt;) is identified by IBM as Greek \&quot;[[Epsilon]] Small\&quot; [U+03B5, ε] but is sometimes rendered in OEM fonts as the [[element (mathematics)|element-of]] sign [U+2208, ∈]. It was often used as the [[euro sign]] [U+20AC, €]}}&quot;}},&quot;i&quot;:254}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;2229&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+239&amp;#10;U+2229 INTERSECTION&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;∩&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;Intersection#Notation&quot;},&quot;style&quot;:{&quot;wt&quot;:&quot;background:#EFF&quot;}},&quot;i&quot;:255}},&quot;\n|-\n!&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-left1&quot;,&quot;href&quot;:&quot;./Template:Chset-left1&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Fx&lt;br/&gt;240&quot;}},&quot;i&quot;:256}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;2261&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+240&amp;#10;U+2261 IDENTICAL TO&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;≡&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;Triple bar&quot;},&quot;style&quot;:{&quot;wt&quot;:&quot;background:#EFF&quot;}},&quot;i&quot;:257}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;00B1&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+241&amp;#10;U+00B1 PLUS-MINUS SIGN&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;±&quot;},&quot;link&quot;:{&quot;wt&q