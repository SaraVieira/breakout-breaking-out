arget&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;2321&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+245&amp;#10;U+2321 BOTTOM HALF INTEGRAL&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;⌡&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;style&quot;:{&quot;wt&quot;:&quot;background:#EFF&quot;}},&quot;i&quot;:262}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;00F7&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+246&amp;#10;U+00F7 DIVISION SIGN&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;÷&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;style&quot;:{&quot;wt&quot;:&quot;background:#EFF&quot;}},&quot;i&quot;:263}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;2248&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+247&amp;#10;U+2248 ALMOST EQUAL TO&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;≈&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;style&quot;:{&quot;wt&quot;:&quot;background:#EFF&quot;}},&quot;i&quot;:264}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;00B0&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+248&amp;#10;U+00B0 DEGREE SIGN&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;°&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;style&quot;:{&quot;wt&quot;:&quot;background:#EFF&quot;}},&quot;i&quot;:265}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;2219&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+249&amp;#10;U+2219 BULLET OPERATOR&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;∙&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;fn&quot;:{&quot;wt&quot;:&quot;{{efn|249 (F9&lt;sub&gt;hex&lt;/sub&gt;) and 250 (FA&lt;sub&gt;hex&lt;/sub&gt;) are almost indistinguishable: the first is a slightly larger dot than the second, both were used as [[bullet (punctuation)|bullets]], [[interpunct|middle dot]], and [[multiplication dot]] [U+2219, ∙]}}&quot;},&quot;style&quot;:{&quot;wt&quot;:&quot;background:#EFF&quot;}},&quot;i&quot;:266}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;00B7&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+250&amp;#10;U+00B7 MIDDLE DOT&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;·&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;interpunct&quot;},&quot;style&quot;:{&quot;wt&quot;:&quot;background:#EFF&quot;}},&quot;i&quot;:267}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;221A&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+251&amp;#10;U+221A SQUARE ROOT&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;√&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;Square root&quot;},&quot;fn&quot;:{&quot;wt&quot;:&quot;{{Efn|251 (FB&lt;sub&gt;hex&lt;/sub&gt;) was also sometimes used as a [[check mark]] [U+2713, ✓].}}&quot;},&quot;style&quot;:{&quot;wt&quot;:&quot;background:#EFF&quot;}},&quot;i&quot;:268}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;207F&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+252&amp;#10;U+207F SUPERSCRIPT LATIN SMALL LETTER N&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;ⁿ&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;&quot;}},&quot;i&quot;:269}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;00B2&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+253&amp;#10;U+00B2 SUPERSCRIPT TWO&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;²&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;&quot;}},&quot;i&quot;:270}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-cell1&quot;,&quot;href&quot;:&quot;./Template:Chset-cell1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;25A0&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+254&amp;#10;U+25A0 BLACK SQUARE&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;■&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;&quot;},&quot;style&quot;:{&quot;wt&quot;:&quot;background:#EFF&quot;}},&quot;i&quot;:271}},&quot;\n|&quot;,{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;chset-ctrl1&quot;,&quot;href&quot;:&quot;./Template:Chset-ctrl1&quot;},&quot;params&quot;:{&quot;u&quot;:{&quot;wt&quot;:&quot;00A0&quot;},&quot;1&quot;:{&quot;wt&quot;:&quot;Alt+255&amp;#10;U+00A0 NO-BREAK SPACE&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;{{resize|60%|NBSP}}&quot;},&quot;link&quot;:{&quot;wt&quot;:&quot;Non-breaking space&quot;},&quot;fn&quot;:{&quot;wt&quot;:&quot;{{Efn|255 (FF&lt;sub&gt;hex&lt;/sub&gt;) draws a blank space; the use as non-breaking space (NBSP) has precedent in [[word processor]]s designed for the IBM PC.}}&quot;}},&quot;i&quot;:272}},&quot;\n|}&quot;]}">
